<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiTrigesimaCuartaApp"
        tools:targetApi="31">

        <!-- Actividad Principal -->
        <activity
            android:name=".ActividadPrincipalMiTrigesimaCuartaApp"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Actividad de Configuración -->
        <activity
            android:name=".actividades_secundarias.ActividadConfiguracion"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:screenOrientation="portrait">
        </activity>

        <!-- Actividad Desplegadora de Datos -->
        <activity
            android:name=".actividades_secundarias.ActividadDesplegadoraDatos"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="screenSize|orientation"
            android:screenOrientation="landscape">
        </activity>
    </application>

    <!-- Permisos para almacenamiento externo -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:remove="android:maxSdkVersion" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.STORAGE" />

    <!-- Permiso para sensores a alta frecuencia -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS"/>
</manifest>