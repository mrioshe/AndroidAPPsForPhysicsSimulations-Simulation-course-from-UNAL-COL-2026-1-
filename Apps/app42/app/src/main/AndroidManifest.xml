<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.curso_simulaciones.micuadragesimasegundaapp">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiCuadragesimaSegundaApp"
        tools:targetApi="31">

        <!-- ── Actividad principal ── -->
        <activity
            android:name=".ActividadPrincipalMiCuadragesimaSegundaApp"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Actividades secundarias ── -->
        <activity
            android:name=".actividades_secundarias.ActividadComunicacion"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:screenOrientation="portrait" />

        <activity
            android:name=".actividades_secundarias.ActividadComoClientePubMQTT"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:screenOrientation="portrait" />

        <activity
            android:name=".actividades_secundarias.ActividadComoClienteSubMQTT"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:screenOrientation="portrait" />

        <activity
            android:name=".actividades_secundarias.ActividadConfiguracion"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:screenOrientation="portrait" />

    </application>

    <!-- Mantiene CPU activa durante transmisión MQTT -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Acceso a Internet para conectar al broker MQTT -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Verificar estado de la red -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Muestreo rápido de sensores (Android 12+) -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

</manifest>